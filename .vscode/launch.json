{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug tracker-api",
            "program": "${workspaceFolder}/app/tracker-api/server.js",
            "cwd": "${workspaceFolder}/app/tracker-api",
            "env": {
                "DB_ADAPTER": "dynamodb"
            },
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Depurar con Live Server",
            "url": "http://127.0.0.1:5500/app/web/index.html?env=local",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "/usr/bin/chromium-browser",
            "userDataDir": false
        }
    ]
}